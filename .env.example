# Copy to .env at the project root for Docker Compose.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=portfolio
IP_HASH_SECRET=replace-with-a-separate-long-random-secret
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=8080
SITE_URL=http://localhost:8080
# For local backend development, also set DATABASE_URL in backend/.env.
DATABASE_URL=postgresql+psycopg://portfolio:replace-with-your-password@localhost:5432/portfolio
# ENVIRONMENT=development
# CONTACT_RATE_LIMIT=5
# CONTACT_WINDOW_SECONDS=3600

# Backend only. Grounded mode works without an AI provider.
ASSISTANT_MODE=auto
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
ASSISTANT_RATE_LIMIT=30
ASSISTANT_SESSION_LIMIT=30
# ASSISTANT_TIMEOUT_SECONDS=15
# ASSISTANT_SESSION_TTL_SECONDS=1800
# Add your Groq key and restart the backend to enable AI fact selection.

# Keys remain server-side. Missing keys return an explicit configuration error.
AI_PROVIDER=groq
CONTACT_RECEIVER_EMAIL=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
FRONTEND_URL=http://127.0.0.1:5173
# Resend HTTPS works on free Render; SMTP is optional on hosts permitting SMTP ports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
