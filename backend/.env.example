# Copy to backend/.env for local development. In production, configure these
# values in the backend host dashboard instead of uploading an .env file.
AI_API_KEY=
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
ASSISTANT_MODE=auto
DATABASE_URL=postgresql+psycopg://portfolio:your-password@localhost:5432/portfolio
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5173
IP_HASH_SECRET=replace-with-a-private-random-value-of-at-least-32-characters
CONTACT_RECEIVER_EMAIL=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Optional SMTP alternative for hosts that allow outbound SMTP ports.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_STARTTLS=false
